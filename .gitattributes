# Normalise line endings in the repository, while each machine keeps its own.
* text=auto

*.cs   text diff=csharp
*.xml  text
*.md   text
*.props text
*.yml  text

# Binaries: neither normalised nor diffed as text.
*.png binary
*.jpg binary
*.dll binary

# Pickle pass maps are read by a bash `while read` in the staging script: a carriage return at the end of a
# line would stay in the Workshop id and the line would not stage. Always LF, whatever the machine's setting.
*.map text eol=lf
